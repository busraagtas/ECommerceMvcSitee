@model List<ECommerceMvcSite.Models.Product>

<h2>Admin Panel - Ürünler</h2>
<p><a href="@Url.Action("Create", "Product")" class="btn btn-success">Yeni Ürün Ekle</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Fiyat</th>
            <th>Açıklama</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.Description</td>
                <td>
                    <a href="@Url.Action("Edit", "Product", new { id = item.Id })" class="btn btn-warning">Düzenle</a>
                    <a href="@Url.Action("Delete", "Product", new { id = item.Id })" class="btn btn-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
